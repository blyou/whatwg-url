{
  "name": "@blyou/whatwg-url",
  "version": "0.0.1",
  "description": "a zero-dependency, WHATWG URL & URLSearchParams implementation for DOM-less ES2023 environments.",
  "keywords": [
    "url",
    "urlsearchparams",
    "whatwg"
  ],
  "homepage": "https://github.com/blyou/whatwg-url#readme",
  "bugs": {
    "url": "https://github.com/blyou/whatwg-url/issues"
  },
  "license": "MIT",
  "author": "blyou <youbolincode@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blyou/whatwg-url.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "fetch:wpt": "node scripts/fetch-wpt-resources.mjs",
    "test:wpt": "pnpm build && vitest run tests/wpt-tests",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "git:hooks": "pnpm simple-git-hooks",
    "taze": "pnpx taze -I"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@types/node": "^26.1.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vue/eslint-config-typescript": "^14.9.0",
    "bumpp": "^12.1.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.76.0",
    "eslint-plugin-vue": "^10.10.0",
    "lint-staged": "^17.2.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "simple-git-hooks": "^2.13.1",
    "terser": "^5.49.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
